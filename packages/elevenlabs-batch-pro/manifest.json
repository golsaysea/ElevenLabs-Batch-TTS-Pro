{
  "manifest_version": 3,
  "name": "ElevenLabs 批量工坊 (负载均衡版)",
  "version": "8.0.1",
  "description": "统一 API 池、综合额度、跨 API 账号一键复制/同步音色（兼容免费号）、音频效果、自动添加标签与批量开头标签、GitHub 自动更新提示。",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "system.display",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.elevenlabs.io/*",
    "https://elevenlabs.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "打开负载均衡工坊"
  },
  "icons": {
     "16": "icon.png",
     "48": "icon.png",
     "128": "icon.png"
  }
}
